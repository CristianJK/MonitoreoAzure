        {
          "name": "Listar Pull Requests activos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/repositories/{{repositoryId}}/pull-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "repositories",
                "{{repositoryId}}",
                "pull-requests"
              ]
            },
            "description": "Devuelve las Pull Requests activas del repositorio indicado por repositoryId."
          },
          "response": []
        }
      ]
    }
  ],
