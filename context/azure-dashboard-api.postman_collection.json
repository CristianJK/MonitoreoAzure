        {
          "name": "Listar ramas de un repositorio",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/repositories/{{repositoryId}}/branches",
              "host": [
